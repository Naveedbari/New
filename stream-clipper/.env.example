# Copy this file to .env and change what you need.

# Whisper model: small (fast, works on any PC) or medium (more accurate, wants a good CPU or an NVIDIA GPU)
WHISPER_MODEL=small
# auto, cpu or cuda
WHISPER_DEVICE=auto
# default, int8 (fast on CPU) or float16 (GPU)
WHISPER_COMPUTE=default

# Captions: original = the streamer's own language (Urdu, Hindi, ...), english = translate to English
CAPTION_LANGUAGE=original

# How many clips to make per stream
CLIP_COUNT=5

# Download quality cap (saves disk space)
MAX_HEIGHT=1080

# If YouTube asks you to sign in, borrow cookies from your browser: chrome, edge, firefox, brave ...
COOKIES_FROM_BROWSER=

# Live streams: record from the very beginning of the stream (true) or from now (false)
LIVE_FROM_START=true

# Cut silent gaps longer than 1 second (never inside the main reaction)
REMOVE_SILENCE=true
